# TravelMate environment. Copy to .env and fill in. Never commit real secrets.
# Server-only values must never be exposed to the browser (only NEXT_PUBLIC_* reach the frontend).

# ── Database (postgres profile / docker compose) ──
DB_NAME=travelmate
DB_USER=travelmate
DB_PASSWORD=change-me
DB_URL=jdbc:postgresql://localhost:5432/travelmate

# ── Redis (Phase 2: distributed rate limiting + cache) ──
REDIS_URL=redis://localhost:6379

# ── Auth ──
# At least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=
# true in any HTTPS deployment
COOKIE_SECURE=false
# Optional: create the first SUPER_ADMIN on startup if this email does not exist yet
TRAVELMATE_BOOTSTRAP_ADMIN_EMAIL=
TRAVELMATE_BOOTSTRAP_ADMIN_PASSWORD=

# ── URLs ──
FRONTEND_URL=http://localhost:3000
# Used by the Next.js server to reach the API (rewrites + server-side fetches)
API_URL=http://localhost:8080

# ── AI planner (optional). Without a key the offline deterministic planner is used and labelled as such. ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# ── Maps / routing ── osrm | none (none = straight-line distance only, clearly labelled)
ROUTING_PROVIDER=osrm
# The public demo server is for light development use only; self-host OSRM for production.
OSRM_BASE_URL=https://router.project-osrm.org

# ── Weather ── open-meteo | none
WEATHER_PROVIDER=open-meteo
OPEN_METEO_BASE_URL=https://api.open-meteo.com

# ── Object storage (Phase 2: documents, memories) ──
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Email (Phase 2; Phase 1 logs emails to the console in dev) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# ── SMS / payments (Phase 3) ──
SMS_PROVIDER_API_KEY=
PAYMENT_PROVIDER_SECRET_KEY=
